{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus / Mimir / Grafana Metrics / Grafana Cloud data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__elements": {},
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",    "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel",      "id": "stat",       "name": "Stat",       "version": "" },
    { "type": "panel",      "id": "timeseries", "name": "Time series","version": "" },
    { "type": "panel",      "id": "piechart",   "name": "Pie chart",  "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true, "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "BurstGrid scheduler health, job flow, and microVM performance. Metrics are exported via the OTel collector in deploy/otel-collector/collector.yaml. Metric names use Prometheus naming (dots → underscores). Requires Grafana 9+.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "external link",
      "tags": [],
      "targetBlank": true,
      "title": "GitHub",
      "tooltip": "BurstGrid repository",
      "type": "link",
      "url": "https://github.com/gbudjeakp/burstgrid"
    }
  ],
  "panels": [

    {
      "type": "stat",
      "id": 1,
      "title": "Queue Depth",
      "description": "Jobs currently waiting to be dispatched to a worker.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 50   },
              { "color": "red",    "value": 200  }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "burstgrid_queue_depth",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ]
    },

    {
      "type": "stat",
      "id": 2,
      "title": "Workers Connected",
      "description": "Worker agents with an active SSE connection to the scheduler.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 1    },
              { "color": "green",  "value": 2    }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "burstgrid_workers_connected",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ]
    },

    {
      "type": "stat",
      "id": 3,
      "title": "Free VM Slots",
      "description": "Total free microVM slots across all connected workers.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 1    },
              { "color": "green",  "value": 4    }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "burstgrid_workers_free_slots",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ]
    },

    {
      "type": "stat",
      "id": 4,
      "title": "Jobs Queued / min",
      "description": "Rate at which new jobs are arriving from GitHub webhooks.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(burstgrid_jobs_queued_total[5m]) * 60",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ]
    },

    {
      "type": "stat",
      "id": 5,
      "title": "Jobs Dispatched / min",
      "description": "Rate at which jobs are being dispatched to workers.",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(burstgrid_jobs_dispatched_total[5m]) * 60",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ]
    },

    {
      "type": "stat",
      "id": 6,
      "title": "Dispatch Latency P95",
      "description": "95th percentile queue-to-dispatch latency over the last 5 minutes.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null  },
              { "color": "yellow", "value": 1000  },
              { "color": "red",    "value": 10000 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(burstgrid_job_dispatch_latency_ms_bucket[5m])) by (le))",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ]
    },

    {
      "type": "timeseries",
      "id": 7,
      "title": "Queue Depth & Capacity",
      "description": "Job queue depth vs. free VM slots. When queue depth > free slots, jobs are waiting for capacity.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10,
            "gradientMode": "none", "spanNulls": false,
            "showPoints": "auto", "pointSize": 4,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto", "axisColorMode": "text",
            "scaleDistribution": { "type": "linear" },
            "axisCenteredZero": false,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "free_slots" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "queue_depth" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "workers_connected" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "burstgrid_queue_depth",
          "legendFormat": "queue_depth",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "burstgrid_workers_free_slots",
          "legendFormat": "free_slots",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "burstgrid_workers_connected",
          "legendFormat": "workers_connected",
          "refId": "C"
        }
      ]
    },

    {
      "type": "timeseries",
      "id": 8,
      "title": "Job Outcomes / min",
      "description": "Terminal and intermediate job status events by type. A healthy fleet shows mostly 'completed'. Spikes in 'failed' or 'timeout' warrant investigation.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": { "mode": "normal", "group": "A" },
            "axisPlacement": "auto", "axisColorMode": "text",
            "scaleDistribution": { "type": "linear" },
            "axisCenteredZero": false,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "failed"  },
            "properties": [{ "id": "color", "value": { "fixedColor": "red",    "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "timeout" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "completed" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green",  "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(burstgrid_jobs_outcomes_total{status=\"completed\"}[$__rate_interval])) * 60",
          "legendFormat": "completed",
          "refId": "completed"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(burstgrid_jobs_outcomes_total{status=\"failed\"}[$__rate_interval])) * 60",
          "legendFormat": "failed",
          "refId": "failed"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(burstgrid_jobs_outcomes_total{status=\"timeout\"}[$__rate_interval])) * 60",
          "legendFormat": "timeout",
          "refId": "timeout"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(burstgrid_jobs_outcomes_total{status=\"running\"}[$__rate_interval])) * 60",
          "legendFormat": "running",
          "refId": "running"
        }
      ]
    },

    {
      "type": "timeseries",
      "id": 9,
      "title": "Dispatch Latency (queue → worker)",
      "description": "Time from when a job was queued to when it was dispatched to a worker. Sub-5ms is expected when workers have free slots.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5,
            "gradientMode": "none", "spanNulls": false,
            "showPoints": "never", "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto", "axisColorMode": "text",
            "scaleDistribution": { "type": "log", "log": 10 },
            "axisCenteredZero": false,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum(rate(burstgrid_job_dispatch_latency_ms_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(burstgrid_job_dispatch_latency_ms_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum(rate(burstgrid_job_dispatch_latency_ms_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },

    {
      "type": "timeseries",
      "id": 10,
      "title": "VM Boot Duration",
      "description": "Firecracker microVM boot time (from API call to kernel ready). Target: < 200ms. Buckets: 50 / 100 / 200 / 500 / 1000 / 2000 ms.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5,
            "gradientMode": "none", "spanNulls": false,
            "showPoints": "never", "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto", "axisColorMode": "text",
            "scaleDistribution": { "type": "log", "log": 10 },
            "axisCenteredZero": false,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "thresholdsStyle": {
              "mode": "line",
              "steps": [{ "color": "transparent", "value": null }, { "color": "orange", "value": 200 }]
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 200 }]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum(rate(burstgrid_vm_boot_duration_ms_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(burstgrid_vm_boot_duration_ms_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum(rate(burstgrid_vm_boot_duration_ms_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },

    {
      "type": "timeseries",
      "id": 11,
      "title": "Job Duration by Tier",
      "description": "P50 and P95 total job execution time inside the microVM, broken down by execution tier. Buckets: 1s / 10s / 1m / 5m / 30m.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5,
            "gradientMode": "none", "spanNulls": false,
            "showPoints": "never", "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto", "axisColorMode": "text",
            "scaleDistribution": { "type": "log", "log": 10 },
            "axisCenteredZero": false,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum(rate(burstgrid_job_duration_ms_bucket[$__rate_interval])) by (le, tier))",
          "legendFormat": "p50 {{tier}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(burstgrid_job_duration_ms_bucket[$__rate_interval])) by (le, tier))",
          "legendFormat": "p95 {{tier}}",
          "refId": "B"
        }
      ]
    },

    {
      "type": "timeseries",
      "id": 12,
      "title": "Worker Host CPU Utilization",
      "description": "CPU utilization on worker EC2 hosts (from hostmetrics scraper). High utilization during VM boot storms is expected and normal.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20,
            "gradientMode": "opacity", "spanNulls": false,
            "showPoints": "never", "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto", "axisColorMode": "text",
            "scaleDistribution": { "type": "linear" },
            "axisCenteredZero": false,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "thresholdsStyle": { "mode": "line" }
          },
          "mappings": [],
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 0.75 },
              { "color": "red",    "value": 0.90 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg without(cpu, state) (rate(system_cpu_time_seconds_total{state!=\"idle\"}[$__rate_interval]))",
          "legendFormat": "{{host.name}}",
          "refId": "A"
        }
      ]
    },

    {
      "type": "timeseries",
      "id": 13,
      "title": "Worker Host Memory Utilization",
      "description": "Memory utilization on worker hosts. MicroVMs have dedicated memory allocations; headroom is required for the host kernel and agent.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
