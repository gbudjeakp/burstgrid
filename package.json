{
  "name": "burstgrid",
  "version": "1.14.0",
  "bin": {
    "burstgrid": "dist/burstgrid.mjs"
  },
  "description": "CI runner scheduling and execution platform — diversified EC2 worker fleet with Firecracker microVM isolation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "dev:scheduler": "tsx bin/scheduler.ts",
    "dev:agent": "tsx bin/worker-agent.ts",
    "dev:init": "tsx bin/init.ts",
    "lint": "oxlint src/ bin/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "infra:init": "cd deploy/terraform && terraform init",
    "infra:plan": "cd deploy/terraform && terraform plan",
    "infra:apply": "cd deploy/terraform && terraform apply"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1137.0",
    "@aws-sdk/client-ec2": "^3.1137.0",
    "@aws-sdk/client-s3": "^3.1137.0",
    "@aws-sdk/client-sqs": "^3.1137.0",
    "@aws-sdk/s3-request-presigner": "^3.1137.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@fastify/rate-limit": "^10.3.0",
    "@octokit/app": "^15.1.6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace": "^2.11.0",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@floci/testcontainers": "^0.1.0",
    "@types/node": "^22.20.4",
    "oxlint": "^0.18.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1"
    }
  }
}
